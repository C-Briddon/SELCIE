{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SELCIE MCP Tools Schema",
  "version": "1.0.0",
  "tools": [
    {
      "name": "calculate_physical_parameters",
      "description": "Convert physical chameleon parameters to SELCIE's dimensionless α and assess the screening regime using the Compton wavelength criterion. Use this first to determine if SELCIE is needed or if analytic solutions suffice. Returns the dimensionless Compton wavelength λ̂(ρ̂) = √(α/(n+1)) × ρ̂^{-(n+2)/(2(n+1))} at the density extremes, which determines field behavior: λ̂ << 1 means adiabatic (field tracks ρ̂^{-1/(n+1)}), λ̂ >> 1 means field is constant, λ̂ ~ 1 is the transition region where SELCIE is needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "beta": {
            "type": "number",
            "description": "Matter coupling strength β. M = M_pl/β where M_pl is Planck mass. Typical values: β=1 (gravitational strength), β=10^6-10^8 (lab experiments).",
            "exclusiveMinimum": 0
          },
          "Lambda_eV": {
            "type": "number",
            "description": "Energy scale Λ in eV. Default 2.4e-3 (dark energy scale, corresponds to Λ ~ 2.4 meV).",
            "default": 2.4e-3,
            "exclusiveMinimum": 0
          },
          "n": {
            "type": "integer",
            "description": "Potential power in V(φ) = Λ⁴(1 + Λⁿ/φⁿ). Default 1.",
            "default": 1,
            "minimum": 1
          },
          "rho_0": {
            "type": "number",
            "description": "Characteristic density scale of the system (e.g., central density, object density). Enters the α calculation as α ∝ 1/ρ₀.",
            "exclusiveMinimum": 0
          },
          "rho_0_units": {
            "type": "string",
            "enum": ["g/cm^3", "kg/m^3", "eV^4", "M_sun/kpc^3", "GeV^4"],
            "description": "Units of rho_0."
          },
          "L": {
            "type": "number",
            "description": "Characteristic length scale of the system (e.g., object radius, domain size). Enters the α calculation as α ∝ 1/L².",
            "exclusiveMinimum": 0
          },
          "L_units": {
            "type": "string",
            "enum": ["m", "cm", "km", "R_sun", "kpc", "Mpc", "AU"],
            "description": "Units of L."
          },
          "rho_max": {
            "type": "number",
            "description": "Maximum density in system, in same units as rho_0. Used for regime estimation via Compton wavelength.",
            "exclusiveMinimum": 0
          },
          "rho_min": {
            "type": "number",
            "description": "Minimum density in system, in same units as rho_0. Used for regime estimation via Compton wavelength.",
            "exclusiveMinimum": 0
          }
        },
        "required": ["beta", "rho_0", "rho_0_units", "L", "L_units"]
      }
    },
    {
      "name": "create_mesh",
      "description": "Generate a finite element mesh for chameleon field simulations. Uses geometry templates that automatically handle subdomain creation, symmetry, and mesh refinement. Templates include object-in-vacuum (sphere_in_vacuum, ellipse_in_vacuum, etc.), plain domains (box_2d, disk, etc.), and custom shapes from file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "geometry": {
            "type": "string",
            "enum": [
              "sphere_in_vacuum", "ellipse_in_vacuum", "ellipsoid_in_vacuum",
              "cylinder_in_vacuum", "shell_in_vacuum", "two_spheres", "sphere_near_wall",
              "box_2d", "box_3d", "disk", "sphere_domain",
              "custom_2d", "custom_3d"
            ],
            "description": "Geometry template. Object-in-vacuum templates create source + vacuum regions. Plain domain templates create empty domains for custom density fields. Custom templates load shapes from file."
          },
          "params": {
            "type": "object",
            "description": "Geometry-specific parameters.",
            "properties": {
              "object_radius": {"type": "number", "exclusiveMinimum": 0, "description": "Radius of spherical source"},
              "vacuum_radius": {"type": "number", "exclusiveMinimum": 0, "description": "Outer radius of vacuum region"},
              "wall_thickness": {"type": "number", "exclusiveMinimum": 0, "description": "Wall thickness (sphere_in_vacuum: optional chamber wall, sphere_near_wall: required physical wall)"},
              "rx": {"type": "number", "exclusiveMinimum": 0, "description": "Semi-axis in r/x direction"},
              "ry": {"type": "number", "exclusiveMinimum": 0, "description": "Semi-axis in z/y direction"},
              "rz": {"type": "number", "exclusiveMinimum": 0, "description": "Semi-axis in z direction (3D)"},
              "radius": {"type": "number", "exclusiveMinimum": 0, "description": "Radius for cylinder, disk, sphere_domain"},
              "height": {"type": "number", "exclusiveMinimum": 0, "description": "Height for cylinder, box"},
              "width": {"type": "number", "exclusiveMinimum": 0, "description": "Width for box"},
              "depth": {"type": "number", "exclusiveMinimum": 0, "description": "Depth for box_3d"},
              "inner_radius": {"type": "number", "exclusiveMinimum": 0, "description": "Inner radius for shell"},
              "outer_radius": {"type": "number", "exclusiveMinimum": 0, "description": "Outer radius for shell"},
              "radius_1": {"type": "number", "exclusiveMinimum": 0, "description": "First sphere radius (two_spheres)"},
              "radius_2": {"type": "number", "exclusiveMinimum": 0, "description": "Second sphere radius (two_spheres)"},
              "separation": {"type": "number", "exclusiveMinimum": 0, "description": "Center-to-center separation (two_spheres)"},
              "wall_distance": {"type": "number", "exclusiveMinimum": 0, "description": "Distance from sphere center to wall top at z=0 (sphere_near_wall)"},
              "points": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "minItems": 3, "description": "Array of [r,z] points defining custom 2D shape"},
              "shape_file": {"type": "string", "description": "Path to file with (r,z) points (custom_2d)"},
              "contours_file": {"type": "string", "description": "Path to JSON file with 3D contours (custom_3d)"}
            }
          },
          "mesh_quality": {
            "type": "string",
            "enum": ["very_coarse", "coarse", "medium", "fine", "very_fine"],
            "description": "Mesh resolution. very_coarse: ~200, coarse: ~500, medium: ~2000, fine: ~8000, very_fine: ~32000. Default: medium.",
            "default": "medium"
          },
          "symmetry": {
            "type": "string",
            "enum": ["axial", "none"],
            "description": "Symmetry assumption. axial: 2D mesh in (r,z) plane with axisymmetry. none: true 2D or full 3D. Default: inferred from geometry.",
            "default": null
          },
          "physics_params": {
            "type": "object",
            "description": "Physics-aware mesh refinement parameters.",
            "properties": {
              "lambda_subdomain": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Dimensionless Compton wavelength inside the object subdomain. Used to estimate thin-shell thickness and refine mesh at boundaries."
              }
            }
          },
          "custom_id": {
            "type": "string",
            "description": "Custom mesh ID. Default: auto-generated.",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          }
        },
        "required": ["geometry", "params"]
      }
    },
    {
      "name": "plot_mesh",
      "description": "Generate a visualization of a mesh showing the geometry and subdomain structure. Returns a PNG image with different colors for each subdomain region.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mesh_id": {
            "type": "string",
            "description": "ID of the mesh to plot."
          },
          "show_edges": {
            "type": "boolean",
            "default": true,
            "description": "Show cell edges. Default: true."
          },
          "title": {
            "type": "string",
            "description": "Custom plot title. Default: auto-generated from mesh info."
          },
          "output_path": {
            "type": "string",
            "description": "Save plot to this path. If not provided, returns base64-encoded image."
          },
          "figsize": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2,
            "default": [8, 8],
            "description": "Figure size [width, height] in inches."
          },
          "dpi": {
            "type": "integer",
            "default": 150,
            "minimum": 50,
            "maximum": 600,
            "description": "Resolution in dots per inch."
          }
        },
        "required": ["mesh_id"]
      }
    },
    {
      "name": "solve",
      "description": "Solve the chameleon field equation α∇²φ + φ^{-(n+1)} = ρ on the specified mesh with the given density profile.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mesh_id": {
            "type": "string",
            "description": "ID of the mesh."
          },
          "alpha": {
            "type": "number",
            "description": "Dimensionless α parameter. Use calculate_physical_parameters to compute from physical values.",
            "exclusiveMinimum": 0
          },
          "density": {
            "type": "object",
            "description": "Density specification per region. Keys are region names from mesh. Values can be: a number (constant), an object with 'expression' (custom formula), or an object with 'file' (tabulated data).",
            "additionalProperties": {
              "oneOf": [
                {"type": "number", "description": "Constant density value"},
                {
                  "type": "object",
                  "properties": {
                    "expression": {"type": "string", "description": "Python expression using r, z, x, y coordinates"}
                  },
                  "required": ["expression"]
                },
                {
                  "type": "object",
                  "properties": {
                    "file": {"type": "string", "description": "Path to tabulated data file"},
                    "skip_header": {"type": "integer", "minimum": 0, "description": "Header lines to skip. Default: 0"}
                  },
                  "required": ["file"]
                }
              ]
            }
          },
          "n": {
            "type": "integer",
            "description": "Potential power. Default: 1.",
            "default": 1,
            "minimum": 1
          },
          "method": {
            "type": "string",
            "enum": ["picard", "auto"],
            "description": "Solver method. auto uses picard with relaxation based on alpha. Default: auto.",
            "default": "auto"
          },
          "tol": {
            "type": "number",
            "description": "Convergence tolerance. Default: 1e-8.",
            "default": 1e-8,
            "exclusiveMinimum": 0
          },
          "max_iter": {
            "type": "integer",
            "description": "Maximum iterations. Default: 100.",
            "default": 100,
            "minimum": 1
          },
          "relaxation": {
            "type": "number",
            "description": "Relaxation factor for Picard iteration (0 < ω ≤ 1). Default: 1.0.",
            "default": 1.0,
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "initial_guess": {
            "type": "string",
            "enum": ["constant", "adiabatic", "previous"],
            "description": "Initial guess strategy. constant: use lowest density across subdomains (SELCIE default). adiabatic: use local minimum. previous: use previous solution.",
            "default": "constant"
          },
          "custom_id": {
            "type": "string",
            "description": "Custom solution ID."
          }
        },
        "required": ["mesh_id", "alpha", "density"]
      }
    },
    {
      "name": "evaluate",
      "description": "Evaluate field values, gradients, and fifth force at specified locations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "solution_id": {
            "type": "string",
            "description": "ID of the solution to evaluate."
          },
          "mode": {
            "type": "string",
            "enum": ["radial", "line", "points", "grid"],
            "description": "Evaluation mode."
          },
          "params": {
            "type": "object",
            "description": "Mode-specific parameters.",
            "properties": {
              "n_points": {"type": "integer", "minimum": 2},
              "r_min": {"type": "number", "minimum": 0},
              "r_max": {"type": "number"},
              "log_spacing": {"type": "boolean", "default": true},
              "direction": {"type": "array", "items": {"type": "number"}},
              "start": {"type": "array", "items": {"type": "number"}},
              "end": {"type": "array", "items": {"type": "number"}},
              "coordinates": {"type": "array", "items": {"type": "array"}},
              "r_range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
              "z_range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
              "n_r": {"type": "integer", "minimum": 2},
              "n_z": {"type": "integer", "minimum": 2}
            }
          },
          "quantities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["field", "gradient", "gradient_magnitude", "fifth_force", "fifth_force_g", "density", "adiabatic_field", "field_deviation"]
            },
            "description": "Quantities to compute. Default: all.",
            "default": ["field", "gradient_magnitude", "fifth_force_g", "density", "adiabatic_field"]
          }
        },
        "required": ["solution_id", "mode"]
      }
    },
    {
      "name": "analyze",
      "description": "Perform physical analysis of a solution: identify screening regime, locate screening radius, compute thin-shell properties, and provide interpretation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "solution_id": {
            "type": "string",
            "description": "ID of the solution to analyze."
          },
          "reference": {
            "type": "string",
            "enum": ["adiabatic", "thin_shell", "none"],
            "description": "Compare to analytic reference. Default: adiabatic.",
            "default": "adiabatic"
          }
        },
        "required": ["solution_id"]
      }
    },
    {
      "name": "compare",
      "description": "Compare multiple solutions, useful for parameter sweeps or comparing different configurations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "solution_ids": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 2,
            "description": "List of solution IDs to compare."
          },
          "metric": {
            "type": "string",
            "enum": ["all", "screening", "force", "field"],
            "description": "Comparison focus. Default: all.",
            "default": "all"
          }
        },
        "required": ["solution_ids"]
      }
    },
    {
      "name": "plot",
      "description": "Generate visualizations of solutions, meshes, or comparisons.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "solution_id": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}}
            ],
            "description": "Solution ID(s) to plot."
          },
          "plot_type": {
            "type": "string",
            "enum": ["field_1d", "field_2d", "force_1d", "force_2d", "comparison", "convergence", "mesh", "density"],
            "description": "Type of plot."
          },
          "options": {
            "type": "object",
            "description": "Plot customization options.",
            "properties": {
              "log_r": {"type": "boolean", "default": false},
              "log_scale": {"type": "boolean", "default": false},
              "show_density": {"type": "boolean", "default": true},
              "show_adiabatic": {"type": "boolean", "default": true},
              "show_screening_radius": {"type": "boolean", "default": true},
              "show_mesh": {"type": "boolean", "default": false},
              "colormap": {"type": "string", "default": "viridis"},
              "units": {"type": "string", "enum": ["g", "m/s^2", "dimensionless"]},
              "style": {"type": "string", "enum": ["magnitude", "vectors"]},
              "quantity": {"type": "string"},
              "legend_by": {"type": "string"},
              "show_regions": {"type": "boolean"},
              "show_quality": {"type": "boolean"},
              "figsize": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
              "dpi": {"type": "integer", "minimum": 50, "maximum": 600}
            }
          },
          "output_path": {
            "type": "string",
            "description": "Save path. If null, returns base64 encoded image."
          },
          "format": {
            "type": "string",
            "enum": ["png", "pdf", "svg"],
            "description": "Output format. Default: png.",
            "default": "png"
          }
        },
        "required": ["solution_id", "plot_type"]
      }
    },
    {
      "name": "sweep",
      "description": "Run a parameter sweep, solving for multiple values of alpha or n using the same mesh and density configuration.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mesh_id": {
            "type": "string",
            "description": "ID of the mesh to use."
          },
          "density": {
            "type": "object",
            "description": "Density specification per region (same as solve tool)."
          },
          "parameter": {
            "type": "string",
            "enum": ["alpha", "n"],
            "description": "Parameter to sweep."
          },
          "values": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "description": "Parameter values to use."
          },
          "n": {
            "type": "integer",
            "description": "Fixed n value (if sweeping alpha). Default: 1.",
            "default": 1
          },
          "alpha": {
            "type": "number",
            "description": "Fixed alpha value (if sweeping n)."
          },
          "solver_options": {
            "type": "object",
            "description": "Solver configuration (same as solve tool)."
          },
          "analyze_each": {
            "type": "boolean",
            "description": "Run analysis on each solution. Default: true.",
            "default": true
          }
        },
        "required": ["mesh_id", "density", "parameter", "values"]
      }
    },
    {
      "name": "get_state",
      "description": "Query current session state: list all meshes and solutions.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "clear",
      "description": "Clear session objects to free memory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string",
            "enum": ["all", "solutions", "meshes"],
            "description": "What to clear. Default: all.",
            "default": "all"
          },
          "ids": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Specific IDs to clear. If not provided, clears all of specified type."
          }
        }
      }
    },
    {
      "name": "get_documentation",
      "description": "Get documentation on profiles, geometries, physics concepts, or troubleshooting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": ["profiles", "geometries", "regimes", "parameters", "units", "solver", "examples"],
            "description": "Topic to get documentation for."
          }
        },
        "required": ["topic"]
      }
    }
  ]
}
